{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Noterad",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}/dd.ps1",
                "build",
                "-Config",
                "Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "detail": "CMake + Ninja via dd.ps1"
        },
        {
            "label": "Build Noterad (Release)",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}/dd.ps1",
                "build"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "detail": "CMake + Ninja via dd.ps1"
        },
        {
            "label": "Test Noterad",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}/dd.ps1",
                "test"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
